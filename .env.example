ADMIN_USER=thinu
ADMIN_PASSWORD=Abc@123
# Any long random string; if empty, a random one is generated each start (logins reset on restart).
SECRET_KEY=

# Reply drafts: "none" = FAQ-only drafts (default), "gemini" = hosted Gemini, "ollama" = local LLM
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=30

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Ollama (only if LLM_PROVIDER=ollama)
OLLAMA_URL=
OLLAMA_MODEL=
